  "contract": {
    "ingress": "startWithSemantic calls observe immediately. RuntimeResources.observeArena first validates achieved Usage, then requires exact Arena.maxOwnedBytes == Budget.maxOwnedBytes before totalOwnedBytes and allocation. A mismatch suspends with arenaBudgetMismatch. It does not synchronize the ceiling.",
    "preexisting_usage": "An already achieved peak above the requested maximum is ownedByteLimit at validateUsage, which precedes the equality test. No smaller invalid Arena is constructed.",
    "extension": "Existing extend deliberately creates the proposed ceiling for validation. On success it installs that ceiling; on refusal it retains the original Arena/budget. Terminal states are exact and inert.",
    "Product8fff": {
      "machine_binding_sha256": "c162ddde520e47c9f8ba8ed02604c5ccc91b319c05aa76a06c97b20500a241d0",
      "migration_doc_sha256": "31273099b62eb7924cb4190001bb85c3a098d17804ff1d79c8b6a457d4c7f1ce",
      "finding": "MachineBinding.start forwards transfer.ready, supplied operationalBudget, transfer.semanticBudget, transfer.semanticLedger directly to Engine.startWithSemantic. It inherits the matching-ceiling requirement and does not synchronize or prove a caller budget matches."
    }
  },

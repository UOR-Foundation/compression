Uorc.Uorc.Integrity.ProfilePartitionLaws.profile_update_step_append_advanced
  (job next : Uorc.Uorc.Integrity.Profile.Update) (suffix : ByteArray)
  (success : Uorc.Uorc.Integrity.Profile.updateStep job = Except.ok (Uorc.Uorc.Integrity.Profile.Event.advanced next)) :
  Uorc.Uorc.Integrity.Profile.updateStep
      (Uorc.Uorc.Integrity.ProfilePartitionLaws.withInput job
        (Uorc.Uorc.Integrity.ProfilePartitionLaws.jobInput job ++ suffix)
        (Uorc.Uorc.Integrity.ProfilePartitionLaws.jobOffset job)) =
    Except.ok
      (Uorc.Uorc.Integrity.Profile.Event.advanced
        (Uorc.Uorc.Integrity.ProfilePartitionLaws.withInput next
          (Uorc.Uorc.Integrity.ProfilePartitionLaws.jobInput next ++ suffix)
          (Uorc.Uorc.Integrity.ProfilePartitionLaws.jobOffset next)))
Uorc.Uorc.Integrity.ProfilePartitionLaws.profile_update_step_done_exact (job : Uorc.Uorc.Integrity.Profile.Update)
  (out : Uorc.Uorc.Integrity.Profile.State) (replacement : ByteArray)
  (success : Uorc.Uorc.Integrity.Profile.updateStep job = Except.ok (Uorc.Uorc.Integrity.Profile.Event.done out)) :
  out = Uorc.Uorc.Integrity.ProfilePartitionLaws.jobState job ∧
    Uorc.Uorc.Integrity.ProfilePartitionLaws.jobOffset job =
        (Uorc.Uorc.Integrity.ProfilePartitionLaws.jobInput job).size ∧
      Uorc.Uorc.Integrity.Profile.beginUpdate out replacement =
          Except.ok (Uorc.Uorc.Integrity.ProfilePartitionLaws.withInput job replacement 0) ∧
        Uorc.Uorc.Integrity.Profile.updateStep
            (Uorc.Uorc.Integrity.ProfilePartitionLaws.withInput job ByteArray.empty 0) =
          Except.ok (Uorc.Uorc.Integrity.Profile.Event.done out)
Uorc.Uorc.Integrity.ProfilePartitionLaws.withInput_self (job : Uorc.Uorc.Integrity.Profile.Update) :
  Uorc.Uorc.Integrity.ProfilePartitionLaws.withInput job (Uorc.Uorc.Integrity.ProfilePartitionLaws.jobInput job)
      (Uorc.Uorc.Integrity.ProfilePartitionLaws.jobOffset job) =
    job
Uorc.Uorc.Integrity.ProfilePartitionLaws.profile_run_update_append_suffix (fuel : Nat)
  (job : Uorc.Uorc.Integrity.Profile.Update) (suffix : ByteArray) :
  Uorc.Uorc.Integrity.Profile.runUpdate fuel
      (Uorc.Uorc.Integrity.ProfilePartitionLaws.withInput job
        (Uorc.Uorc.Integrity.ProfilePartitionLaws.jobInput job ++ suffix)
        (Uorc.Uorc.Integrity.ProfilePartitionLaws.jobInput job).size) =
    Uorc.Uorc.Integrity.Profile.runUpdate fuel (Uorc.Uorc.Integrity.ProfilePartitionLaws.withInput job suffix 0)
Uorc.Uorc.Integrity.ProfilePartitionLaws.profile_run_update_append_composition (firstFuel secondFuel : Nat)
  (job next : Uorc.Uorc.Integrity.Profile.Update) (suffix : ByteArray) (middle out : Uorc.Uorc.Integrity.Profile.State)
  (first : Uorc.Uorc.Integrity.Profile.runUpdate firstFuel job = Except.ok middle)
  (admission : Uorc.Uorc.Integrity.Profile.beginUpdate middle suffix = Except.ok next)
  (second : Uorc.Uorc.Integrity.Profile.runUpdate secondFuel next = Except.ok out) :
  Uorc.Uorc.Integrity.Profile.runUpdate (firstFuel + secondFuel)
      (Uorc.Uorc.Integrity.ProfilePartitionLaws.withInput job
        (Uorc.Uorc.Integrity.ProfilePartitionLaws.jobInput job ++ suffix)
        (Uorc.Uorc.Integrity.ProfilePartitionLaws.jobOffset job)) =
    Except.ok out
Uorc.Uorc.Integrity.ProfilePartitionLaws.profile_run_update_done_settled (fuel : Nat)
  (job : Uorc.Uorc.Integrity.Profile.Update) (out : Uorc.Uorc.Integrity.Profile.State)
  (success : Uorc.Uorc.Integrity.Profile.runUpdate fuel job = Except.ok out) :
  ∃ emptyJob,
    Uorc.Uorc.Integrity.Profile.beginUpdate out ByteArray.empty = Except.ok emptyJob ∧
      Uorc.Uorc.Integrity.Profile.runUpdate 1 emptyJob = Except.ok out
Uorc.Uorc.Integrity.ProfilePartitionLaws.profile_begin_update_exact (state : Uorc.Uorc.Integrity.Profile.State)
  (input : ByteArray) (job : Uorc.Uorc.Integrity.Profile.Update)
  (success : Uorc.Uorc.Integrity.Profile.beginUpdate state input = Except.ok job) :
  Uorc.Uorc.Integrity.ProfilePartitionLaws.jobState job = state ∧
    Uorc.Uorc.Integrity.ProfilePartitionLaws.jobInput job = input ∧
      Uorc.Uorc.Integrity.ProfilePartitionLaws.jobOffset job = 0
Uorc.Uorc.Integrity.ProfilePartitionLaws.profile_update_success_driver (state : Uorc.Uorc.Integrity.Profile.State)
  (input : ByteArray) (out : Uorc.Uorc.Integrity.Profile.State)
  (success : Uorc.Uorc.Integrity.Profile.update state input = Except.ok out) :
  ∃ job,
    Uorc.Uorc.Integrity.Profile.beginUpdate state input = Except.ok job ∧
      Uorc.Uorc.Integrity.Profile.runUpdate (600 * input.size + 1200) job = Except.ok out
Uorc.Uorc.Integrity.ProfilePartitionLaws.profile_update_partition_success_agrees
  (state : Uorc.Uorc.Integrity.Profile.State) (left right : ByteArray)
  (middle partitioned whole : Uorc.Uorc.Integrity.Profile.State)
  (first : Uorc.Uorc.Integrity.Profile.update state left = Except.ok middle)
  (second : Uorc.Uorc.Integrity.Profile.update middle right = Except.ok partitioned)
  (single : Uorc.Uorc.Integrity.Profile.update state (left ++ right) = Except.ok whole) : partitioned = whole

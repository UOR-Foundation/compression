Uorc.Uorc.Integrity.ProfilePartitionLaws.chain_update_step_append_advanced
  (job next : Uorc.Uorc.Integrity.BoundedChain.Update) (suffix : ByteArray)
  (success :
    Uorc.Uorc.Integrity.BoundedChain.updateStep job =
      Except.ok (Uorc.Uorc.Integrity.BoundedChain.UpdateEvent.advanced next)) :
  Uorc.Uorc.Integrity.BoundedChain.updateStep
      { state := job.state, input := job.input ++ suffix, offset := job.offset } =
    Except.ok
      (Uorc.Uorc.Integrity.BoundedChain.UpdateEvent.advanced
        { state := next.state, input := next.input ++ suffix, offset := next.offset })
Uorc.Uorc.Integrity.ProfilePartitionLaws.stream_update_step_append_advanced (limit : UInt64)
  (job next : Uorc.Uorc.Integrity.StreamEngine.Update) (suffix : ByteArray)
  (success :
    Uorc.Uorc.Integrity.StreamEngine.updateStepAt limit job =
      Except.ok (Uorc.Uorc.Integrity.StreamEngine.UpdateEvent.advanced next)) :
  Uorc.Uorc.Integrity.StreamEngine.updateStepAt limit
      { state := job.state, input := job.input ++ suffix, offset := job.offset } =
    Except.ok
      (Uorc.Uorc.Integrity.StreamEngine.UpdateEvent.advanced
        { state := next.state, input := next.input ++ suffix, offset := next.offset })
Uorc.Uorc.Integrity.ProfilePartitionLaws.chain_update_step_done_exact (job : Uorc.Uorc.Integrity.BoundedChain.Update)
  (out : Uorc.Uorc.Integrity.BoundedChain.State)
  (success :
    Uorc.Uorc.Integrity.BoundedChain.updateStep job =
      Except.ok (Uorc.Uorc.Integrity.BoundedChain.UpdateEvent.done out)) :
  out = job.state ∧
    job.offset = job.input.size ∧
      Uorc.Uorc.Integrity.BoundedChain.valid job.state = true ∧
        job.state.closing = false ∧ job.state.stage = Uorc.Uorc.Integrity.BoundedChain.Stage.idle
Uorc.Uorc.Integrity.ProfilePartitionLaws.stream_update_step_done_exact (limit : UInt64)
  (job : Uorc.Uorc.Integrity.StreamEngine.Update) (out : Uorc.Uorc.Integrity.StreamEngine.State)
  (success :
    Uorc.Uorc.Integrity.StreamEngine.updateStepAt limit job =
      Except.ok (Uorc.Uorc.Integrity.StreamEngine.UpdateEvent.done out)) :
  out = job.state ∧
    job.offset = job.input.size ∧
      Uorc.Uorc.Integrity.StreamEngine.validAt limit job.state = true ∧
        job.state.closing = false ∧
          ∃ hashState,
            job.state.stage = Uorc.Uorc.Integrity.StreamEngine.Stage.ready hashState ∧
              Uorc.Uorc.Integrity.Sha256.hasWork hashState = false ∧ LexLeanRuntime.equal hashState.count limit = false

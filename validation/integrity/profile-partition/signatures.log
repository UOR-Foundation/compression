Uorc.Uorc.Integrity.ProfilePartitionLaws.profile_begin_update_with_input (state : Uorc.Uorc.Integrity.Profile.State)
  (input replacement : ByteArray) (job : Uorc.Uorc.Integrity.Profile.Update)
  (success : Uorc.Uorc.Integrity.Profile.beginUpdate state input = Except.ok job) :

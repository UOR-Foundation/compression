    Uorc.Uorc.Integrity.ProfilePartitionLaws.profile_run_update_successor.match_3
      (fun x => Except Uorc.Uorc.Integrity.Profile.Error Uorc.Uorc.Integrity.Profile.State)
      (Uorc.Uorc.Integrity.Profile.updateStep job) (fun failure => Except.error failure) fun event =>
      Uorc.Uorc.Integrity.ProfilePartitionLaws.profile_run_update_successor.match_1
        (fun event => Except Uorc.Uorc.Integrity.Profile.Error Uorc.Uorc.Integrity.Profile.State) event
        (fun next => Uorc.Uorc.Integrity.Profile.runUpdate fuel next) fun state => Except.ok state

definition{
  name: boundary,
  parameters: [],
  result: String,
  body: "Read-only wire traversal under an already charged enclosing owner. Cursor holds only handles and fixed-width scalars, never Arena, Bytes, Rope or a traversal stack. Each call performs one bounded node descent or reports one borrowed image span. It allocates and retains no ticket. This Step.borrowedSpan is distinct from RuntimeSequence.Outcome.span, whose nonempty result transfers an owned image ticket. A caller of the Core-owned sequence operation must separately inventory that returned ticket; no terminal-cursor normalization is performed here. The wire producer keeps its enclosing owner while a borrowed event is pending and explicitly retains a ticket only on a requested transfer.",
  axioms: [Quot.sound, propext],
  executable: true
}
\end{semanticmodule}
\end{lexlean}

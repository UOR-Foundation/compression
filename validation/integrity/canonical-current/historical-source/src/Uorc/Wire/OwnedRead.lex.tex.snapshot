              | Uorc.Core.Heap::Node.metadataLink u0Local34 u1Local35 u2Local36 => (ctor Step.failed (ctor Failure.invalidShape))
              | Uorc.Core.Heap::Node.metadataBranch u0Local37 u1Local38 u2Local39 => (ctor Step.failed (ctor Failure.invalidShape))
              | Uorc.Core.Heap::Node.ownerRoot u0Local40 u1Local41 => (ctor Step.failed (ctor Failure.invalidShape))
              | Uorc.Core.Heap::Node.imageReservation u0Local42 u1Local43 => (ctor Step.failed (ctor Failure.invalidShape))))))) else (ctor Step.failed (ctor Failure.range)))
      | Uorc.Core.Heap::Node.sequenceBranch cachedLengthLocal44 heightLocal45 leftLocal46 rightLocal47 => (match (Uorc.Core.Heap::sequenceInfo arena leftLocal46)
        | Result.error eLocal48 => (ctor Step.failed (ctor Failure.heap eLocal48))
        | Result.ok leftInfoLocal49 => (let nextLocal50 : Uorc.Core.RuntimeValue::Handle := (if (Uorc.Core.Heap::less (project cursor index) (project leftInfoLocal49 length)) then leftLocal46 else rightLocal47); (if (Uorc.Core.Heap::less (project nextLocal50 id) (project (project cursor current) id)) then (ctor Step.advanced (record Cursor {root := (project cursor root), length := (project cursor length), offset := (project cursor offset), current := nextLocal50, index := (if (Uorc.Core.Heap::less (project cursor index) (project leftInfoLocal49 length)) then (project cursor index) else (Uorc.Core.Heap::wordSub (project cursor index) (project leftInfoLocal49 length))), walking := (project cursor walking)})) else (ctor Step.failed (ctor Failure.invalidShape)))))

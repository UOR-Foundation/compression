                | Option.some sizeLocal15 => (if (Uorc.Core.Heap::less sizeLocal15 endLocal10) then (ctor Step.failed (ctor Failure.range)) else (ctor Step.borrowedSpan imageLocal5 offsetLocal9 countLocal8 (record Cursor {root := (project cursor root), length := (project cursor length), offset := (Uorc.Core.Heap::wordAdd (project cursor offset) countLocal8), current := (project cursor current), index := (project cursor index), walking := false}))))
              | Uorc.Core.Heap::Node.sequenceLeaf u0Local16 u1Local17 u2Local18 => (ctor Step.failed (ctor Failure.invalidShape))
              | Uorc.Core.Heap::Node.sequenceBranch u0Local19 u1Local20 u2Local21 u3Local22 => (ctor Step.failed (ctor Failure.invalidShape))
              | Uorc.Core.Heap::Node.storeLeaf u0Local23 => (ctor Step.failed (ctor Failure.invalidShape))

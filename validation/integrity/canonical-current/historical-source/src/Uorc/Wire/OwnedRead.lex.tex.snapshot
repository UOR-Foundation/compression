definition{
  name: step,
  parameters: [arena : Uorc.Core.Heap::Arena, cursor : Cursor],
  result: Step,
  body: (if (prim equal (project cursor offset) (project cursor length) : Bool) then (ctor Step.complete) else (if (Uorc.Core.Heap::less (project cursor length) (project cursor offset)) then (ctor Step.failed (ctor Failure.range)) else (if (project cursor walking) then (match (Uorc.Core.Heap::lookup arena (project cursor current))

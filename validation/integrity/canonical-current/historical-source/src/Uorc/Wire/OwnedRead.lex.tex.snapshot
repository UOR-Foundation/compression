      | Uorc.Core.Heap::Node.storeLeaf u0Local53 => (ctor Step.failed (ctor Failure.invalidShape))
      | Uorc.Core.Heap::Node.storeBranch u0Local54 u1Local55 => (ctor Step.failed (ctor Failure.invalidShape))
      | Uorc.Core.Heap::Node.slot u0Local56 u1Local57 => (ctor Step.failed (ctor Failure.invalidShape))
      | Uorc.Core.Heap::Node.rootBranch u0Local58 u1Local59 u2Local60 => (ctor Step.failed (ctor Failure.invalidShape))
      | Uorc.Core.Heap::Node.metadataWord u0Local61 u1Local62 u2Local63 => (ctor Step.failed (ctor Failure.invalidShape))

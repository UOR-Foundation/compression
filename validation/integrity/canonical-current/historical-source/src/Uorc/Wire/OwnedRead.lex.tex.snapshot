            | Result.ok entryLocal12 => (match (project entryLocal12 node)
              | Uorc.Core.Heap::Node.image kindLocal13 bytesLocal14 => (match (Uorc.Core.Heap::wordOfNat (prim length bytesLocal14 : Nat))

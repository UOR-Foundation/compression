    | Result.ok entryLocal4 => (match (project entryLocal4 node)
      | Uorc.Core.Heap::Node.sequenceLeaf imageLocal5 startLocal6 lengthLocal7 => (if (Uorc.Core.Heap::less (project cursor index) lengthLocal7) then (let countLocal8 : UInt64 := (if (Uorc.Core.Heap::less (Uorc.Core.Heap::wordSub lengthLocal7 (project cursor index)) (Uorc.Core.Heap::wordSub (project cursor length) (project cursor offset))) then (Uorc.Core.Heap::wordSub lengthLocal7 (project cursor index)) else (Uorc.Core.Heap::wordSub (project cursor length) (project cursor offset))); (match (prim checked_add startLocal6 (project cursor index) : (Option UInt64))

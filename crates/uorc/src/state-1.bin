    def bit(s,p,i,b):
        v=p[i]; bound=(s.rng>>BITS)*v
        if b==0: s.rng=bound; p[i]=v+(((1<<BITS)-v)>>MOVE)
        else: s.low+=bound; s.rng-=bound; p[i]=v-(v>>MOVE)

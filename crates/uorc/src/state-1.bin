    runs-on: ${{ matrix.runner }}
    # The full verify's certificate stage runs one Lean process per production
    # root, serially (LexLean 0.4), which alone takes about half an hour; the
    # integrity leg's canonical runtime verifies its own scoped closure.
    timeout-minutes: ${{ (matrix.leg == 'artifacts' || matrix.leg == 'integrity') && 120 || 60 }}
    steps:

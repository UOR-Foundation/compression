P = Prog()
for name, w in [('n', 4), ('dir', 1), ('skip', 1), ('base', 4), ('hits', 4)]:
    P.glob(name, w)
P.table('OUT', 1 << 33)
P.rom('POW2', 4, [1 << k for k in range(33)])


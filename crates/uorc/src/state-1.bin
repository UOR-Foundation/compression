        ('let', 'pos', mod(add(add(G('base'), V('i')), 5), M32)),
        ('let', 'wsum', mod(sel(eq(G('dir'), 0), add(V('v'), V('pos')), sub(add(V('v'), M32), V('pos'))), M32)),
        ('let', 'wlow', mod(V('wsum'), 1 << 25)),

# dir 0 encodes (relative to absolute), 1 decodes; OUT holds the n output bytes
P.func('filter', ['size', 'd', 'at'], [('set', 'n', V('size')), ('set', 'dir', V('d')), ('set', 'base', V('at')),
                                       ('set', 'skip', 0), ('set', 'hits', 0), ('loop', G('n'), 'i', step)])


def py_run(data, d, base=0):
    m = Machine(P, bytes(data))
    m.call('filter', len(data), d, base)
    return bytes(m.t['OUT'].get(k, 0) for k in range(len(data))), m.g['hits']


def py_filter(data, d, base=0):
    return py_run(data, d, base)[0]


if __name__ == '__main__':
    import random
    r = random.Random(3)
    for n in (0, 1, 4, 5, 6, 64, 3000):
        x = bytes(r.choice([0xE8, 0xE9, 0, 255, r.randrange(256)]) for _ in range(n))
        for base in (0, 7, M32 - 3):
            y = py_filter(x, 0, base)
            assert py_filter(y, 1, base) == x, n
            assert py_filter(py_filter(x, 1, base), 0, base) == x, n
    print('x86 filter round-trips')
# The x86 filter's decoding direction as a UORC program graph block, compiled from x86_model by irgraph
# (scratch writing aid). library(g) adds x86Run(sequence, dir, base) -> sequence: dir 0 applies the
# filter, 1 undoes it, with the bytes placed at `base` in the stream.
import sys
import os
HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
from g import Graph, N, Y, S, T
import irgraph, x86_model


def library(g=None):
    c = irgraph.Compiler(x86_model.P, g)
    roms = c.load_roms()
    inp = c.input_loader()
    f = c.function('filter')
    b = c.g.block('x86Byte', [N, T], Y)
    b.returns(b.sread(b.arg(1), b.add(x86_model.P.tables['OUT'], b.arg(0))))
    out = b
    b = c.g.block('x86Run', [S, N, N], S)
    sq = b.arg(0)
    n = b.slen(sq)
    st = b.fold(n, b.snew(b.byte(0)), inp, [sq])
    st = b.apply(roms, [st])
    st = b.apply(f, [st, n, b.arg(1), b.arg(2)])
    b.returns(b.tabulate(n, out, [st]))
    return c.g, b
//! The BDD runner and the honesty meta-gate (R2, R3, `CM-02`, `CM-03`).
//!
//! Two jobs, and they are different in kind.
//!
//! **R3, feature-first.** Every capability begins as a Gherkin scenario. The
//! runner below reads `features/suites/*.feature`, extracts the conformance IDs
//! the scenarios are tagged with, and cross-checks them against the register
//! and against the test names in the workspace. An ID with no scenario, a
//! scenario with no ID, and an ID with no test are all failures. There are no
//! pending or skipped steps, because a pending step is a claim with nothing
//! behind it.
//!
//! **R2, the meta-gate.** The honesty levels only mean something if the suite
//! respects them. The gate proves that no `open` claim is asserted as
//! established and that no `some-true` claim is presented as though this
//! repository had established it. That is a check on the *documentation and the
//! test names*, not on the arithmetic --- which is why it lives here rather
//! than in a numerical crate.

#![deny(missing_docs)]

pub mod meta;
pub mod runner;

pub use meta::{assertive_term, check_honesty, HonestyReport};
pub use runner::{scenarios_in, Scenario, SuiteReport};
